{
  "name": "@bvdaniel/private-pay-core",
  "version": "0.3.0",
  "description": "Core wrapper around CDP smart accounts for private USDC payments on Base. Self-funded gas via batched swap.",
  "keywords": [
    "private",
    "payments",
    "usdc",
    "base",
    "cdp",
    "wallets",
    "crypto"
  ],
  "license": "MIT",
  "author": "a0x-co <hi@a0x.co>",
  "homepage": "https://a0x-confidential-pay-demo-2w42vltmu-bvdaniels-projects.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a0x-co/a0x-private-pay.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/a0x-co/a0x-private-pay/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
