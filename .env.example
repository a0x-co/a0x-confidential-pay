# CDP authentication (see https://docs.cdp.coinbase.com/wallets/quickstart/api-key-auth)
# Create an API key at portal.cdp.coinbase.com/api-keys/secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Generate a Wallet Secret at portal.cdp.coinbase.com/wallets/non-custodial/security
CDP_WALLET_SECRET=

# Network to use for local dev: base-sepolia | base-mainnet
CDP_NETWORK=base-sepolia